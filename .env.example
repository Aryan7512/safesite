# ── App (public; bundled into the app) ─────────────────────────────────────
# Supabase → Project Settings → API Keys
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# One-tap demo login tiles on the Login screen (demo builds only)
EXPO_PUBLIC_DEMO_MODE=1
EXPO_PUBLIC_DEMO_PASSWORD=PlantX-Demo-2026

# ── Scripts only: put this in .env.local (git-ignored), never in .env ──────
# SUPABASE_SECRET_KEY=sb_secret_...
